# --- PostgreSQL (shared by the db container and the app) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
# Outside docker compose: POSTGRES_HOST=localhost (compose sets it to "db" itself)
# Or a full URL instead of POSTGRES_*: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# --- Web UI / API access (HTTP Basic). Empty password = no auth, local dev only ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Telegram ---
# Token from @BotFather. For "connected Telegram" enable Business Mode for the bot in @BotFather.
BOT_TOKEN=
# polling — separate bot process (docker compose); webhook — bot inside the web app (Render)
BOT_MODE=polling
# Public HTTPS URL for webhook mode; on Render RENDER_EXTERNAL_URL is used automatically
# WEBHOOK_BASE_URL=https://crm.example.com
# Services offered by the bot; the chosen one becomes a tag on the lead
BOT_SERVICES=Сайт,Реклама,SMM,Дизайн,Другое

# Host port for the web UI
APP_PORT=8000
